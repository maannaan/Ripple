{
  "name": "ripple",
  "private": true,
  "scripts": {
    "trueforge": "bash scripts/start-trueforge.sh",
    "check": "bash scripts/check-env.sh",
    "verify:phase0": "bash scripts/verify-phase0.sh",
    "configure:anthropic": "bash scripts/configure-anthropic.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:setup": "bash scripts/setup-db.sh",
    "db:migrate": "bash scripts/migrate-db.sh",
    "mcp:dev": "npm run dev --workspace=mcp-server",
    "mcp:register": "bash scripts/register-mcp.sh",
    "agent:create": "bash scripts/create-ripple-agent.sh",
    "agent:create:fireworks": "RIPPLE_MODEL=fireworks/minimax-m3 bash scripts/create-ripple-agent.sh",
    "agent:update": "bash scripts/update-ripple-agent.sh",
    "agent:update:phase4": "npm run agent:update && npm run verify:phase4",
    "skill:register": "bash scripts/register-simulation-skill.sh",
    "skill:sync": "bash scripts/sync-simulation-skill.sh",
    "simulation:test": "python3 simulation/tests/run_tests.py",
    "simulation:run": "python3 simulation/simulate_change.py --fixture scenario_a",
    "benchmark:simulation": "bash scripts/benchmark-simulation.sh",
    "e2e:pipeline": "bash scripts/e2e-pipeline.sh",
    "verify:phase3": "bash scripts/verify-phase3.sh",
    "verify:phase4": "bash scripts/verify-phase4.sh",
    "test:apply": "bash scripts/test-apply-update.sh",
    "verify:phase5": "bash scripts/verify-phase5.sh",
    "demo:prep": "bash scripts/demo-prep.sh",
    "rehearsal:verify": "bash scripts/rehearsal-verify.sh",
    "verify:phase6": "bash scripts/verify-phase6.sh",
    "publish:github": "bash scripts/publish-github.sh",
    "pr:phase6": "bash scripts/open-phase6-pr.sh",
    "submission:checklist": "bash scripts/submission-checklist.sh",
    "handoff": "cat docs/HANDOFF.md",
    "fix:sandbox-git": "bash scripts/fix-sandbox-git.sh",
    "eval:agent": "node evals/run-evals.mjs",
    "test:mcp": "npm run test --workspace=mcp-server",
    "deploy:prod": "docker compose -f deploy/docker-compose.prod.yml up -d --build",
    "ripple:setup": "npm run db:setup && npm run mcp:register && npm run agent:create",
    "ci": "npm run build --workspace=mcp-server && npm run test:mcp && npm run simulation:test && npm run eval:agent"
  },
  "workspaces": ["mcp-server"]
}
