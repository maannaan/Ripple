# Ripple environment variables
# Copy to .env for local use. Never commit .env.

# Phase 0 — TrueForge + Anthropic
# Paste ANTHROPIC_API_KEY into TrueForge UI (Settings → Models), or use npm run configure:anthropic
ANTHROPIC_API_KEY=

# TrueForge local runtime
TRUEFORGE_PORT=8790
# Optional: isolate TrueForge SQLite outside default app data dir
# SQLITE_PATH=~/.ripple/trueforge.sqlite

# Phase 2 — Ripple MCP server
MCP_SERVER_PORT=3100

# Phase 1 — operational database (Docker Postgres)
POSTGRES_PORT=5433
POSTGRES_USER=ripple
POSTGRES_PASSWORD=ripple
POSTGRES_DB=ripple
DATABASE_URL=postgres://ripple:ripple@localhost:5433/ripple

# Production / self-hosted (optional)
# RIPPLE_DATA_SOURCE=postgres
# RIPPLE_READ_ONLY=false
# RIPPLE_CONFIG=./config/ripple.config.yaml
# MCP_API_KEYS=dev-key:analyst+approver+admin:local
# MCP_RATE_LIMIT=120
# MCP_RATE_WINDOW_MS=60000
# AUDIT_EXPORT_WEBHOOK_URL=
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# NetSuite connector (when RIPPLE_DATA_SOURCE=netsuite)
# NETSUITE_ACCOUNT_ID=
# NETSUITE_ROLE_ID=
# NETSUITE_BASE_URL=
# NETSUITE_FIXTURE_DIR=mcp-server/src/adapters/netsuite/fixtures
